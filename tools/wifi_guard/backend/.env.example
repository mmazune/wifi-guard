WIFI_GUARD_MODE=demo
WIFI_GUARD_HOST=127.0.0.1
WIFI_GUARD_PORT=8000
WIFI_GUARD_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Default: tools/wifi_guard/.local/wifi_guard.sqlite3 (resolved from the app)
# WIFI_GUARD_DATABASE_PATH=/absolute/path/to/wifi_guard.sqlite3
WIFI_GUARD_HISTORY_LIMIT_PER_DEVICE=100
# Explicitly opt in to OS interface metadata with local_metadata. This never
# enables real discovery and never sends traffic.
WIFI_GUARD_INTERFACE_SOURCE=demo
WIFI_GUARD_JOB_RETENTION_LIMIT=100
WIFI_GUARD_WORKER_POLL_SECONDS=2
WIFI_GUARD_WORKER_LEASE_SECONDS=30
